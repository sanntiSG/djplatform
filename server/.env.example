PORT=4000

# MongoDB Atlas — obtene la URI desde tu cluster en atlas.mongodb.com
MONGODB_URI=mongodb+srv://<usuario>:<password>@cluster0.xxxxx.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT — MINIMO 64 caracteres aleatorios. Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Google OAuth — console.cloud.google.com > Credenciales > OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary — cloudinary.com > Dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# URL del frontend (en produccion, la URL de Netlify)
# En desarrollo: http://localhost:5173
# En produccion: https://tu-app.netlify.app
CLIENT_URL=http://localhost:5173

# Admin inicial
ADMIN_EMAIL=ssantii200@gmail.com
# Solo necesario para el script seed:admin. Eliminar de produccion despues de ejecutarlo.
ADMIN_INITIAL_PASSWORD=

# Sightengine — moderacion automatica de contenido (sightengine.com)
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=

# ============================================================
# WEB PUSH NOTIFICATIONS (gratis, sin limites, estandar W3C)
# ============================================================
# Generar UNA SOLA VEZ con:
#   cd server
#   npx tsx scripts/generateVapidKeys.ts
#
# El script imprime las dos lineas exactas listas para pegar aqui.
# Copiar tambien en las variables de entorno de Render (Environment).
#
# Estas claves NO se pagan ni se registran en ningun servicio externo.
# Son un par criptografico local que el navegador usa para autenticar
# que las notificaciones push vienen de tu servidor y de nadie mas.
#
# IMPORTANTE: una vez en produccion, NO cambiar estas claves.
# Cambiarlas invalida todas las suscripciones existentes de los usuarios.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ssantii200@gmail.com

# ============================================================
# LAST.FM — Tendencias musicales (gratis, sin limite mensual)
# ============================================================
# Registrate en https://www.last.fm/api/account/create
# Copia el "API Key" que generan (es inmediato y gratis).
# Si no se configura, la seccion de tendencias simplemente no aparece.
LASTFM_API_KEY=

# Entorno
NODE_ENV=development
