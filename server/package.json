{
  "name": "@dj/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "seed:admin": "tsx src/scripts/seedAdmin.ts",
    "seed:catalogs": "tsx src/scripts/seedCatalogs.ts",
